[resource]
script = ExtResource("1_entry")
entry_id = &"cyber_worm"
category = 1
display_name = "Cyber Worm"
type_label = "Priority Boss Virus"
description = "A segmented wave boss that emerges gradually from its tunnel. Towers prioritize the closest worm segment, but only the five body sections take damage. Its head and tail are shielded unless Nullifier suppresses that defense in range."
images = Array[Texture2D]([ExtResource("2_head"), ExtResource("3_body"), ExtResource("4_tail")])
slide_labels = Array[String](["Shielded Head", "Damageable Body", "Shielded Tail"])
