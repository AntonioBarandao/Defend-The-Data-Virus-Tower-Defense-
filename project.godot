; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Defend The Data"
run/main_scene="res://Scenes/Menus/MainMenu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=60
config/icon="res://icon.svg"

[autoload]

AssetCache="*res://Scripts/Menus/asset_cache.gd"
CustomCursorController="*res://Scenes/UI/CustomCursor.tscn"
UISelectSoundController="*res://Scenes/Audio/UISelectSoundController.tscn"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor]

import/use_multiple_threads=false
version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/xogot_connect/plugin.cfg")

[global_group]

Defender=""
Music="Gameplay music controlled by the Music settings slider."
OFFENSE_TOWER=""
Sound="Gameplay and interface sounds controlled by the Sound settings slider."
SUPPORT_TOWER=""
Virus=""

[input_devices]

virtual_controller/ios/enable_controller=false
virtual_controller/ios/enable_left_thumbstick=true
virtual_controller/ios/enable_right_thumbstick=true
virtual_controller/ios/enable_button_a=true
virtual_controller/ios/enable_button_b=true
virtual_controller/ios/enable_button_x=true
virtual_controller/ios/enable_button_y=true

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
textures/vram_compression/import_s3tc_bptc=true
textures/vram_compression/import_etc2_astc=true
